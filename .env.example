# neatlogs project key (traces + MCP read-back)
NEATLOGS_API_KEY=
NEATLOGS_PROJECT_ID=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# OpenAI-compatible model gateway (primary)
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1

# Venice (fallback model provider)
VENICE_API_KEY=

# Gemini (text-to-speech)
GEMINI_API_KEYS=

# Venice fallback models per role (optional)
VENICE_MODEL_EDITOR=
VENICE_MODEL_WRITER=
VENICE_MODEL_VISION=
VENICE_MODEL_EXTRACTOR=
VENICE_MODEL_JUDGE=

# Optional: an explicit browser binary for rendering (see packages/reel/src/render.ts)
DAILIES_BROWSER_EXECUTABLE=
